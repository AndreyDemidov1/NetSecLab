<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetSecLab.App.MainWindow"
        Width="1610"
        Height="760"
        MinWidth="1250"
        MinHeight="700"
        Title="NetSecLab">
    <Grid RowDefinitions="Auto,*" Background="#111827">
        <Border Grid.Row="0" Padding="24,18" Background="#0F172A">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="NetSecLab"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="Интерактивный тренажёр по анализу сетевых атак и защите"
                               Foreground="#CBD5E1"
                               FontSize="14" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#172033"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,8"
                        VerticalAlignment="Center">
                    <TextBlock Text="Логическая симуляция"
                               Foreground="#CBD5E1"
                               FontSize="13" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="360,*"
              Margin="20"
              ColumnSpacing="20">
            <Border Grid.Column="0"
                    Background="#1F2937"
                    CornerRadius="16"
                    Padding="0"
                    ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="18">
                        <Border Background="#0F172A"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Учебный сценарий"
                                               Foreground="White"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Сначала выберите задачу, затем настройте атаку и защиту"
                                               Foreground="#94A3B8"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ComboBox ItemsSource="{Binding Scenarios}"
                                          SelectedItem="{Binding SelectedScenario}"
                                          IsEnabled="{Binding ScenarioConfigurationEnabled}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Border Background="#111827"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Задача"
                                                   Foreground="#94A3B8"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding ScenarioGoalText}"
                                                   Foreground="#E5E7EB"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button Grid.Column="0"
                                            Content="Начать"
                                            Command="{Binding StartScenarioCommand}"
                                            IsEnabled="{Binding CanStartScenario}"
                                            Background="#2563EB"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="Сбросить"
                                            Command="{Binding ResetScenarioCommand}"
                                            IsEnabled="{Binding CanResetScenario}"
                                            Background="#334155"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Stretch" />
                                </Grid>

                                <Border Background="#172033"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Прогресс"
                                                   Foreground="#94A3B8"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding ScenarioStatusText}"
                                                   Foreground="White"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding ScenarioScoreText}"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ScenarioBreakdownText}"
                                               Foreground="#CBD5E1"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ScenarioReactionText}"
                                               Foreground="#94A3B8"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="#334155" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Генератор атак"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Настройка и запуск логической генерации трафика"
                                       Foreground="#94A3B8"
                                       FontSize="13"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Тип атаки" Foreground="#CBD5E1" />
                            <ComboBox ItemsSource="{Binding AttackTypes}"
                                      SelectedItem="{Binding SelectedAttackType}"
                                      IsEnabled="{Binding AttackConfigurationEnabled}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="Целевой IP" Foreground="#CBD5E1" />
                            <TextBox Text="{Binding TargetIp, Mode=TwoWay}"
                                     IsEnabled="{Binding AttackConfigurationEnabled}" />

                            <TextBlock Text="Целевой порт" Foreground="#CBD5E1" />
                            <TextBox Text="{Binding TargetPortText, Mode=TwoWay}"
                                     IsEnabled="{Binding AttackConfigurationEnabled}" />

                            <TextBlock Text="Интенсивность, пакетов/сек" Foreground="#CBD5E1" />
                            <TextBox Text="{Binding IntensityText, Mode=TwoWay}"
                                     IsEnabled="{Binding AttackConfigurationEnabled}" />

                            <TextBlock Text="Уровень стохастики" Foreground="#CBD5E1" />
                            <ComboBox ItemsSource="{Binding SimulationDifficulties}"
                                      SelectedItem="{Binding SelectedDifficulty}"
                                      IsEnabled="{Binding AttackConfigurationEnabled}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <CheckBox Content="Добавлять фоновый трафик"
                                      IsChecked="{Binding IncludeBackgroundTraffic}"
                                      IsEnabled="{Binding AttackConfigurationEnabled}"
                                      Foreground="#E5E7EB" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button Grid.Column="0"
                                    Content="Запустить"
                                    Command="{Binding StartAttackCommand}"
                                    Background="#16A34A"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1"
                                    Content="Остановить"
                                    Command="{Binding StopAttackCommand}"
                                    Background="#DC2626"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Stretch" />
                        </Grid>

                        <Button Content="Очистить журнал"
                                Command="{Binding ClearPacketsCommand}"
                                Background="#334155"
                                Foreground="White"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Stretch" />

                        <Border Background="#0F172A"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,4,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Сообщение"
                                           Foreground="#94A3B8"
                                           FontSize="12" />
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="#E5E7EB"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,4,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="События стохастики"
                                           Foreground="#94A3B8"
                                           FontSize="12" />
                                <TextBlock Text="{Binding SimulationStatusText}"
                                           Foreground="#E5E7EB"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="#334155" />

                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Защитные механизмы"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Модуль анализирует логические пакеты и применяет выбранные правила"
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <CheckBox Content="Включить защиту"
                                      IsChecked="{Binding ProtectionEnabled}"
                                      IsEnabled="{Binding DefenseConfigurationEnabled}"
                                      Foreground="#E5E7EB" />

                            <StackPanel Spacing="8"
                                        IsEnabled="{Binding DefenseOptionsEnabled}">
                                <CheckBox Content="SYN cookies"
                                          IsChecked="{Binding SynCookiesEnabled}"
                                          Foreground="#E5E7EB" />

                                <CheckBox Content="Rate limiting"
                                          IsChecked="{Binding RateLimitEnabled}"
                                          Foreground="#E5E7EB" />

                                <TextBlock Text="Лимит однотипных пакетов/сек" Foreground="#CBD5E1" />
                                <TextBox Text="{Binding RateLimitText, Mode=TwoWay}"
                                         IsEnabled="{Binding RateLimitInputEnabled}" />

                                <CheckBox Content="Чёрный список (blacklist)"
                                          IsChecked="{Binding BlacklistEnabled}"
                                          Foreground="#E5E7EB" />

                                <StackPanel Spacing="6"
                                            IsEnabled="{Binding BlacklistControlsEnabled}">
                                    <TextBox Text="{Binding BlacklistIpText, Mode=TwoWay}"
                                             Watermark="IP-адрес" />

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                        <Button Grid.Column="0"
                                                Content="Добавить"
                                                Command="{Binding AddBlacklistIpCommand}"
                                                IsEnabled="{Binding CanAddBlacklistIp}"
                                                Background="{Binding BlacklistAddButtonBackground}"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Stretch"
                                                Padding="8,4" />
                                        <Button Grid.Column="1"
                                                Content="Убрать"
                                                Command="{Binding RemoveBlacklistIpCommand}"
                                                IsEnabled="{Binding CanRemoveBlacklistIp}"
                                                Background="{Binding BlacklistRemoveButtonBackground}"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Stretch"
                                                Padding="8,4" />
                                        <Button Grid.Column="2"
                                                Content="Убрать все"
                                                Command="{Binding ClearBlacklistIpsCommand}"
                                                IsEnabled="{Binding CanClearBlacklistIps}"
                                                Background="{Binding BlacklistClearButtonBackground}"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Stretch"
                                                Padding="8,4" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="{Binding BlacklistSummaryText}"
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           TextWrapping="Wrap" />

                                <CheckBox Content="Белый список (whitelist)"
                                          IsChecked="{Binding WhitelistEnabled}"
                                          Foreground="#E5E7EB" />

                                <StackPanel Spacing="6"
                                            IsEnabled="{Binding WhitelistControlsEnabled}">
                                    <TextBox Text="{Binding WhitelistIpText, Mode=TwoWay}"
                                             Watermark="IP-адрес" />

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                        <Button Grid.Column="0"
                                                Content="Добавить"
                                                Command="{Binding AddWhitelistIpCommand}"
                                                IsEnabled="{Binding CanAddWhitelistIp}"
                                                Background="{Binding WhitelistAddButtonBackground}"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Stretch"
                                                Padding="8,4" />
                                        <Button Grid.Column="1"
                                                Content="Убрать"
                                                Command="{Binding RemoveWhitelistIpCommand}"
                                                IsEnabled="{Binding CanRemoveWhitelistIp}"
                                                Background="{Binding WhitelistRemoveButtonBackground}"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Stretch"
                                                Padding="8,4" />
                                        <Button Grid.Column="2"
                                                Content="Убрать все"
                                                Command="{Binding ClearWhitelistIpsCommand}"
                                                IsEnabled="{Binding CanClearWhitelistIps}"
                                                Background="{Binding WhitelistClearButtonBackground}"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Stretch"
                                                Padding="8,4" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="{Binding WhitelistSummaryText}"
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           TextWrapping="Wrap" />

                                <CheckBox Content="Поведенческий фильтр"
                                          IsChecked="{Binding BehaviorFilterEnabled}"
                                          Foreground="#E5E7EB" />
                            </StackPanel>

                            <Border Background="#0F172A"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,4,0,0">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Состояние защиты"
                                               Foreground="#94A3B8"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding DefenseStatusText}"
                                               Foreground="#E5E7EB"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,220,*" RowSpacing="14">
                <Border Grid.Row="0"
                        Background="#1F2937"
                        CornerRadius="16"
                        Padding="16">
                    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Background="#0F172A" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Состояние" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock Text="{Binding RunStateText}"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#0F172A" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Получено пакетов" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock Text="{Binding GeneratedPacketsText}"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#0F172A" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Пропущено" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock Text="{Binding AllowedPacketsText}"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

						<Border Grid.Column="3" Background="#0F172A" CornerRadius="12" Padding="14">
							<StackPanel Spacing="4">
								<TextBlock Text="Защищено" Foreground="#94A3B8" FontSize="12" />
								<TextBlock Text="{Binding MitigatedPacketsText}"
										   Foreground="White"
										   FontSize="18"
										   FontWeight="SemiBold" />
							</StackPanel>
						</Border>

                        <Border Grid.Column="4" Background="#0F172A" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Заблокировано" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock Text="{Binding BlockedPacketsText}"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="#1F2937"
                        CornerRadius="16"
                        Padding="14"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                Background="#0F172A"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <StackPanel Grid.Row="0" Spacing="2">
                                    <TextBlock Text="Динамика трафика"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Последние 12 секунд: стабильная шкала до очистки"
                                               Foreground="#94A3B8"
                                               FontSize="12" />
                                </StackPanel>

                                <ItemsControl Grid.Row="1"
                                              ItemsSource="{Binding TrafficTrend}"
                                              VerticalAlignment="Stretch"
                                              HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"
                                                         Columns="12"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="112"
                                                  Margin="2,0"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Bottom">
                                                <StackPanel VerticalAlignment="Bottom"
                                                            HorizontalAlignment="Center">
                                                    <Border Width="16"
                                                            Height="{Binding AttackHeight}"
                                                            Background="#DC2626"
                                                            CornerRadius="4,4,0,0" />
                                                    <Border Width="16"
                                                            Height="{Binding BackgroundHeight}"
                                                            Background="#16A34A"
                                                            CornerRadius="0,0,4,4" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#0F172A"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <StackPanel Grid.Row="0" Spacing="2">
                                    <TextBlock Text="Протоколы"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                </StackPanel>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ProtocolDistribution}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid RowDefinitions="Auto,Auto"
                                                  RowSpacing="4"
                                                  Margin="0,0,0,8"
                                                  MinWidth="0">
                                                <Grid Grid.Row="0"
                                                      ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="8"
                                                      MinWidth="0">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               Foreground="#CBD5E1"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ShareText}"
                                                               Foreground="White"
                                                               FontSize="12"
                                                               TextAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <ProgressBar Grid.Row="1"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding PercentValue}"
                                                             Height="8"
                                                             Margin="2,0"
                                                             Background="#1F2937"
                                                             Foreground="#38BDF8"
                                                             HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#0F172A"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <StackPanel Grid.Row="0" Spacing="2">
                                    <TextBlock Text="Решения защиты"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                </StackPanel>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding DecisionDistribution}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid RowDefinitions="Auto,Auto"
                                                  RowSpacing="4"
                                                  Margin="0,0,0,8"
                                                  MinWidth="0">
                                                <Grid Grid.Row="0"
                                                      ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="8"
                                                      MinWidth="0">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               Foreground="#CBD5E1"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ShareText}"
                                                               Foreground="White"
                                                               FontSize="12"
                                                               TextAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <ProgressBar Grid.Row="1"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding PercentValue}"
                                                             Height="8"
                                                             Margin="2,0"
                                                             Background="#1F2937"
                                                             Foreground="#A78BFA"
                                                             HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="#1F2937"
                        CornerRadius="16"
                        Padding="14"
                        ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid Grid.Row="0"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <StackPanel Grid.Column="0"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Журнал логических пакетов"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Пакеты проходят через модуль защитных механизмов перед отображением"
                                           Foreground="#94A3B8"
                                           FontSize="12" />
                            </StackPanel>

                            <Grid Grid.Column="1"
                                  ColumnDefinitions="150,160,170"
                                  ColumnSpacing="8"
                                  VerticalAlignment="Center">
                                <Border Grid.Column="0"
                                        Background="#0F172A"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,6"
                                        Height="34">
                                    <Grid ColumnDefinitions="Auto,50"
                                          ColumnSpacing="6"
                                          VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0"
                                                   Text="Эффективность:"
                                                   Foreground="#94A3B8"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DefenseEfficiencyText}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="#0F172A"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,6"
                                        Height="34">
                                    <Grid ColumnDefinitions="Auto,45"
                                          ColumnSpacing="6"
                                          VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0"
                                                   Text="Нейтрализовано:"
                                                   Foreground="#94A3B8"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding NeutralizedPacketsText}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="#0F172A"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,6"
                                        Height="34">
                                    <Grid ColumnDefinitions="Auto,95"
                                          ColumnSpacing="6"
                                          VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0"
                                                   Text="Скорость:"
                                                   Foreground="#94A3B8"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CurrentRateText}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Packets}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="1*" MinWidth="110" />
                                <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="2*" MinWidth="170" />
                                <DataGridTextColumn Header="Назначение" Binding="{Binding Destination}" Width="2*" MinWidth="155" />
                                <DataGridTextColumn Header="Протокол" Binding="{Binding Protocol}" Width="1*" MinWidth="110" />
                                <DataGridTextColumn Header="Признак" Binding="{Binding Flags}" Width="1*" MinWidth="125" />
                                <DataGridTextColumn Header="Длина" Binding="{Binding Length}" Width="1*" MinWidth="90" />
                                <DataGridTextColumn Header="Тип пакета" Binding="{Binding Kind}" Width="1*" MinWidth="120" />
                                <DataGridTextColumn Header="Решение" Binding="{Binding Decision}" Width="1*" MinWidth="125" />
                                <DataGridTextColumn Header="Правило" Binding="{Binding DefenseRule}" Width="2*" MinWidth="190" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
